{
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "questions"
      ],
      "properties": {
        "action": {
          "const": "ASK_USER"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "wording",
              "entity",
              "field",
              "scope",
              "owner",
              "kind"
            ],
            "properties": {
              "wording": {
                "type": "string",
                "minLength": 1
              },
              "entity": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "owner": {
                "enum": [
                  "dispatcher",
                  "receiver"
                ]
              },
              "kind": {
                "enum": [
                  "indispensable",
                  "optional"
                ]
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "tool",
        "arguments"
      ],
      "properties": {
        "action": {
          "const": "CALL_TOOL"
        },
        "tool": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "decision"
      ],
      "properties": {
        "action": {
          "const": "FINAL"
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "parameters",
            "plan",
            "evidence",
            "missing_slots"
          ],
          "properties": {
            "action": {
              "enum": [
                "UPDATE",
                "RETAIN",
                "INSUFFICIENT",
                "INFEASIBLE",
                "CLARIFY"
              ]
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400
              }
            },
            "plan": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "status",
                "routes"
              ],
              "properties": {
                "status": {
                  "const": "FEASIBLE"
                },
                "routes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "vehicle",
                      "nodes"
                    ],
                    "properties": {
                      "vehicle": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "nodes": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "missing_slots": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  ]
}
