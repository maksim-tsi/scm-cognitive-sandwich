# ============================================================================
# SCM COGNITIVE SANDWICH - ENVIRONMENT CONFIGURATION
# ============================================================================

# --- 1. EXTERNAL SIMULATION ENVIRONMENT ---
# Maritime Port Sandbox
SANDBOX_API_URL=http://192.168.107.172:8001

# --- External LTM Service (YAAM API) ---
# YAAM frontgate (port 8002) is deprecated. Do not use YAAM_API_URL.

# --- 2. LLM PROVIDER API KEYS ---
# LangGraph agents will use these to authenticate with the chosen models.
# We will primarily use models with strong JSON/Structured Output capabilities.
GROQ_API_KEY=''
MISTRAL_API_KEY=''
GOOGLE_API_KEY=''

# --- OpenRouter (Exec Plan 2 / Variant B) ---
OPENROUTER_API_KEY=''
LLM_MODEL='x-ai/grok-4.1-fast'
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Recommended by OpenRouter for analytics/ranking (polite headers)
OPENROUTER_HTTP_REFERER=https://github.com/maksim-tsi/scm-cognitive-sandwich
OPENROUTER_X_TITLE=SCM-Cognitive-Sandwich-WinSim

# --- 3. OBSERVABILITY (LangSmith / Arize Phoenix) ---
# Optional: To trace the LangGraph execution steps visually
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=''
LANGCHAIN_PROJECT='scm-cognitive-sandwich-winsim'

# --- OBSERVABILITY (Arize Phoenix on skz-dev-lv) ---
PHOENIX_COLLECTOR_ENDPOINT=http://192.168.107.172:6006/v1/traces
PHOENIX_PROJECT_NAME=scm-cognitive-sandwich-winsim

# ============================================================================
# PHASE 2: YAAM INFRASTRUCTURE (skz-dev / skz-data)
# ============================================================================
# Note: Orchestrator now targets memory backends directly via DB drivers.

# --- PostgreSQL (L2 Storage) ---
POSTGRES_HOST=192.168.107.187
POSTGRES_PORT=5432
# POSTGRES_USER=''
# POSTGRES_PASSWORD=''
POSTGRES_DB='yaam_winsim' # Our database for L2 storage. YAAM's internal schema will be created here.

# --- Redis (L1 Working Memory) ---
REDIS_HOST=192.168.107.172
REDIS_PORT=6379
# RediSearch index creation for LangGraph checkpointer uses DB 0 in this setup.
# Shared Redis with YAAM is supported via namespacing (key prefixes and index names).
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
REDIS_PREFIX='sandwich:winsim:' # Prefix for LangGraph keys and RediSearch indexes to avoid collisions with YAAM's usage.

# --- Neo4j (Lineage Truth & Auditability) ---
# NEO4J_URI=bolt://192.168.107.187:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=''

# --- Typesense (L4 Semantic Memory) ---
TYPESENSE_URL=http://192.168.107.187:8108
# TYPESENSE_API_KEY=''
TYPESENSE_COLLECTION='winsim_artifacts' # Isolated collection for LangGraph to store final markdown reports

# --- Qdrant (L3 Vector Memory) ---
QDRANT_URL=http://192.168.107.187:6333
QDRANT_COLLECTION='winsim_episodes' # Isolated collection for LangGraph to store episode vectors without interfering with YAAM's data.
